  {% for section in stack %}
  <section id="{{ section.category | slug }}" class="e-content">
    <h2>{{ section.category }}</h2>

    {% if section.items %}
    <ul class="life-stack-items">
      {% for item in section.items %}
      <li>
        {% if item.url %}<a href="{{ item.url }}" rel="noopener">{{ item.name }}</a>{% else %}{{ item.name }}{% endif %}
        {% if item.description %} — {{ item.description|safe }}{% endif %}
      </li>
      {% endfor %}
    </ul>
    {% endif %}

    {% if section.subcategories %}
      {% for sub in section.subcategories %}
      <h3 id="{{ sub.name | slug }}">{{ sub.name }}</h3>
      <ul class="life-stack-items">
        {% for item in sub.items %}
        <li>
          {% if item.url %}<a href="{{ item.url }}" rel="noopener">{{ item.name }}</a>{% else %}{{ item.name }}{% endif %}
          {% if item.description %} — {{ item.description|safe }}{% endif %}
