<!doctype html>
<html lang="en">

<head>
	<title>{{ title }} - Jacky Alciné</title>
	<meta name="CCBot" content="nofollow">
	<meta name="robots" content="noai, noimageai">
	<meta name="tdm-reservation" content="1">
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<meta name="theme-color" content="#001f3f" />
	<meta name="author" content="Jacky Alciné" />
	<meta name="generator" content="Eleventy v3.0.0">
	{% if og.type -%}<meta property="og:type" content="{{ og.type }}" />{%- endif %}
  {%- if og.image %}
    {% set ogImageUrl = imageUrl(og.image) %}
  {% else %}
    {% set ogImageUrl = "/images/self.jpg" %}
  {%- endif -%}
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:image" content="https://www.jacky.wtf{{ ogImageUrl }}" />
  <meta property="og:image" content="https://www.jacky.wtf{{ ogImageUrl}}" />
  {%- if description %}
    <meta name="twitter:description" content="{{- description -}}" />
    <meta property="og:description" content="{{- description -}}" />
    <meta property="description" content="{{- description -}}" />
	{%- endif %}
	<meta property="og:title" content="{{ og.title | default(title) }} - Jacky Alciné" />
	<meta property="og:site_name" content="Jacky Alciné's digital place to post, post, post!" />
	<meta property="og:url" content="https://www.jacky.wtf{{ page.url }}" />
	<meta name="twitter:title" content="{{ title }} - Jacky Alciné" />
	<meta name="twitter:site" content="Jacky Alciné's digital place" />
	<meta name="twitter:creator" content="@jackyalcine" />
  <meta name="fediverse:creator" content="@jalcine@todon.eu">
	{% block head %}{% endblock head %}
	<link rel="stylesheet" href="/site.css" type="text/css" />
	<link rel="icon" href="https://www.jacky.wtf/images/self.jpg" type="images/jpeg" />
	<link rel="hub" href="https://pubsubhubbub.superfeedr.com/" />
	<link rel="self" href="https://www.jacky.wtf/" />
	<link rel="alternate" href="/essays/feed.atom" type="application/atom+xml" title="Jacky Alciné's essays (over ATOM)" />
	<link rel="alternate" href="/links/feed.atom" type="application/atom+xml" title="Jacky Alciné's linklog (over ATOM)" />
	<link rel="alternate" href="/weeknotes/feed.atom" type="application/atom+xml" title="Jacky Alciné's weeknotes (over ATOM)" />
  <script src="/scripts/main.js" type="module" defer async></script>
  <!-- Privacy-friendly analytics by Plausible -->
  <script async src="https://plausible.io/js/pa-DosHWTTEpYQiGlr25PNp1.js"></script>
  <script>
    window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
    plausible.init()
  </script>
</head>

<body>
	<header>
		<nav>
			<a class="h-card" href="/" rel="me">
				<img class="u-photo" src="/images/self.jpg" height="32px"
					alt="Jacky with gold-brimmed glasses looking to the left." />
				<span class="p-name">
					Jacky Alciné
				</span></a>
			<a class="h-feed u-url" href="/essays/">Essays</a>
			<a class="h-feed u-url" href="/links/">Linklog</a>
			<a class="h-feed u-url" href="/weeknotes/">Weeknotes</a>
			<!-- <a class="h-feed u-url" href="/reads">Reads</a> -->
			<a href="/work/">Work</a>
		</nav>
	</header>
	<main>
		{{- content | safe -}}
	</main>
	<footer>
      <p>Site handrolled <local-time><time datetime="{{ generated.ts }}">at {{ generated.human }}</time></local-time> and built using <a href="https://www.11ty.dev/">11ty</a> (for now)
			&mdash; <a href="https://www.11ty.dev/blog/sustainability-fundraising/">support its
				development</a>!
			Check out <a href="/report/visitors.html">my access logs</a>. <a
				href="/disclaimer">Disclaimer</a>: I have opinions.
      </p>
      <p xmlns:cc="http://creativecommons.org/ns#">
        You made it &mdash; <strong>congrats</strong>! I don't have much to tell you. Except that unless
        otherwise stated,
        the content I publish is licensed under <a
          href="https://creativecommons.org/licenses/by-nc/4.0/?ref=chooser-v1" target="_blank"
          rel="license noopener noreferrer">CC BY-NC 4.0<img
            src="https://mirrors.creativecommons.org/presskit/icons/cc.svg?ref=chooser-v1"
            alt="CC"><img
            src="https://mirrors.creativecommons.org/presskit/icons/by.svg?ref=chooser-v1"
            alt="BY"><img
            src="https://mirrors.creativecommons.org/presskit/icons/nc.svg?ref=chooser-v1"
            alt="SA"></a>.
      </p>
    </footer>
  </body>
</html>
