---
layout: page.html.njk
changeFreq: monthly
og:
  type: article
---
<article class="h-entry">
  <header>
    <h1 class="p-name">
			<a href="{{ material.link }}" class="u-bookmark-of h-cite">{{ material.title }}</a>
	</h1>
    <aside>
		by <a href="{{ material.source.url }}">{{ material.source.name }}</a> &mdash;
		bookmarked <time class="dt-published" datetime="{{ page.date.toUTCString() }}">{{ page.date | postDate }}</time>
    </aside>
  </header>
  <section class="e-content">
    {{- content | safe -}}
  </section>
</article>
