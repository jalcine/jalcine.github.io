---
layout: page.html.njk
changeFreq: monthly
---
{% set regExpCode = r/<pre class=(.|\n)*?<\/pre>/gm %}
{% set fixedContent = content | replace(regExpCode, "") | striptags %}
{% set wordCount = fixedContent | wordcount %}
<article class="h-entry">
  <header>
    <h1 class="p-name">{{ title }}</h1>
    {% if byline %}<h2>{{ byline }}</h2>{% endif %}
    <aside>
      <small>by me, <a class="u-author" href="/">Jacky Alciné</a></small>
      &bull; published
      <time class="dt-published" datetime="{{ page.date.toUTCString() }}">{{ page.date | postDate }}</time>
      &bull;
      <span>{{ content | readingTime }} to read, {{ wordCount }} words </span>
    </aside>
  </header>
  {% if audio %}
  <figure id="audio">
    <figcaption>You can listen to me reading this post!</figcaption>
    <audio preload="metadata" controls>
    {% for src in audio %}
      <source src="/files/recordings/{{ src.src }}" type="{{ src.type }}" />
    {% endfor %}
    </audio>
  </figure>
  {% endif %}
  <section class="e-content">
    {{ content | safe }}
  </section>
</article>
<style>
article { margin: 1rem auto; }
article>header { margin: 0 auto; width: 100%; max-width: 50rem; }
article>header>aside { display: block; text-align: center; }
header>h1 { margin-bottom: 1rem; }
header>h1+h2 { margin-bottom: 1rem; }
.e-content { max-width: var(--content-width); margin: 0 auto; }
article>section>blockquote>p:first-of-type { margin: 0; }
article picture>img {
  max-width: var(--content-width);
}
article>section>blockquote {
  max-width: var(--content-width);
  padding: 1rem;
  font-size: 150%;
  background: var(--pull-bg);
  color: var(--pull-color);
  margin: 1rem 0;
}
li {
  padding: 0 1rem;
}
#audio { margin: 1rem auto; width: 100%; max-width: 40rem; text-align: center; }
#audio > audio {
width: 100%;
}
article>section>p,
article>section>li,
article>section>ul,
article>section>ol,
section.footnotes { 
  max-width: var(--content-width); 
  line-height: var(--txt-line-height); 
  font-size: 120%; 
  text-align: justify;
  text-align-last: left;
  word-wrap: break-word;
}
p+hr { margin: 2rem 0; max-width: var(--content-width); }

@media screen and (max-width: 40rem) {
  article { margin: 1rem 0; }
  article>header { max-width: 100vw; width: 100%; margin: 0; }
  #audio > audio { width: 100%; }
}
</style>
