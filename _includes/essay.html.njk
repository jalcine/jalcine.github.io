---
layout: page.html.njk
changeFreq: monthly
og:
  type: article
---
<article class="h-entry">
  {% if masthead %}
    <figure class="masthead">
        <img src="{{ masthead.src }}" alt="{{ masthead.alt }}"/>
        <figcaption>{{ masthead.title | safe }}</figcaption>
    </figure>
  {% endif %}
  <header>
    <h1 class="p-name">{{ title }}</h1>
    {% if byline %}<h2>{{ byline }}</h2>{% endif %}
    <aside>
      by <a class="u-author" href="/">Jacky Alciné</a>
      &bull; published
      <time class="dt-published" datetime="{{ page.date.toUTCString() }}">{{ page.date | postDate }}</time>
    </aside>
  </header>
  {% if audio %}
  <figure id="audio">
    <figcaption>You can listen to me reading this post!</figcaption>
    <audio preload="metadata" controls>
    {% for src in audio %}
      <source src="/files/recordings/{{ src.src }}" type="{{ src.type }}" />
    {% endfor %}
    </audio>
  </figure>
  {% endif %}
  <section class="e-content">
    {{- content | safe -}}
  </section>
  <sequoia-comments{% if atUri %} document-uri="{{ atUri }}"{% endif %}></sequoia-comments>
  {% include "./content-footer.html" %}
</article>

{% block head %}
  <script type="module" src="/scripts/components/sequoia-comments.js"></script>
{% endblock %}
